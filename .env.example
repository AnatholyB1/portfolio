# ─── Sèvalys — variables d'environnement ─────────────────────────────
# Copier ce fichier en `.env.local` et renseigner les valeurs.

# URL canonique du site (sert au SEO : canonical, sitemap, robots, OG, JSON-LD).
# .com est canonique ; configurer la redirection sevalys.ai → sevalys.com
# côté hébergeur (Vercel → Domains).
NEXT_PUBLIC_SITE_URL=https://sevalys.com

# ─── Analytics PostHog (suivi visiteurs : pages, clics, provenance) ───
# Récupérer la clé projet dans PostHog → Project settings → Project API Key.
# Sans clé, l'analytics est désactivé (no-op) — aucun tracking en local.
NEXT_PUBLIC_POSTHOG_KEY=
# Hôte PostHog. EU recommandé pour le RGPD. (défaut si vide : https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Supabase (dashboard temps réel + API CRM) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
