# ─── Sèvalys — variables d'environnement ─────────────────────────────
# Copier ce fichier en `.env.local` et renseigner les valeurs.

# URL canonique du site (sert au SEO : canonical, sitemap, robots, OG, JSON-LD).
# .com est canonique ; configurer la redirection sevalys.ai → sevalys.com
# côté hébergeur (Vercel → Domains).
NEXT_PUBLIC_SITE_URL=https://sevalys.com

# ─── Analytics PostHog (suivi visiteurs : pages, clics, provenance) ───
# Récupérer la clé projet dans PostHog → Project settings → Project API Key.
# Sans clé, l'analytics est désactivé (no-op) — aucun tracking en local.
NEXT_PUBLIC_POSTHOG_KEY=
# Hôte PostHog. EU recommandé pour le RGPD. (défaut si vide : https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Supabase (dashboard temps réel + API CRM) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique : préférer la clé publishable (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Ancienne clé anon (JWT), utilisée seulement si la publishable est absente.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur (service_role / secret) : Vercel + .env.local uniquement,
# JAMAIS préfixée NEXT_PUBLIC. Ne pas mélanger modes moderne et legacy.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# ─── Espace client / connexion (phase 10) ────────────────────────────
# Passe à true seulement après la vérification SPF/DKIM/DMARC du plan 10-03 (D-20).
SV_LOGIN_ENABLED=false
# Recopier la valeur réelle « Email OTP expiration » du projet Supabase,
# ne pas la modifier : réglage partagé avec Ziko/Gecko.
SV_OTP_EXPIRY_MINUTES=

# ─── Tests RLS (local uniquement, JAMAIS sur Vercel) ─────────────────
# Les valeurs vivent dans `.env.test.local` (ignoré par git via `.env*`).
SV_TEST_ALLOW=
SV_TEST_SUPABASE_URL=
SV_TEST_PUBLISHABLE_KEY=
SV_TEST_SECRET_KEY=
SV_TEST_DB_URL=
SV_TEST_PROJECT_REF=

# ─── Resend (emails du formulaire de contact) ─────────────────────────
# Clé à récupérer dans Resend Dashboard → API Keys → Create API Key.
# À dupliquer dans `.env.local` (dev local) ET dans Vercel → Project →
# Settings → Environment Variables (production).
# Le domaine d'envoi sevalys.com doit être vérifié dans Resend
# (Dashboard → Domains → Add Domain) avant de pouvoir envoyer depuis
# contact@sevalys.com — sans vérification, Resend rejette l'envoi.
# En attendant, utiliser l'expéditeur sandbox onboarding@resend.dev
# pour les tests en local.
RESEND_API_KEY=

# ─── Leads / consentement (phase 11) ───────────────────────────────────
# Clé HMAC pour ip_hash dans sv_lead_contacts et sv_consent_log
# (32+ octets aléatoires, serveur uniquement, jamais NEXT_PUBLIC_).
# SV_IP_HASH_SECRET=

# ─── Signature électronique (phase 14) ─────────────────────────────────
# Secret HMAC des codes de signature (32+ octets aléatoires, hex).
# Requis en production/preview Vercel et dans .env.test.local ; l'application
# refuse d'envoyer un code s'il est absent (fail closed).
# SV_SIGNATURE_CODE_SECRET=
